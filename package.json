{
  "name": "@saboor10131/node-play-library",
  "version": "1.1.4",
  "description": "node library for playing around",
  "type": "module",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "require": "./dist/cjs/index.cjs",
      "import": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "test": "jest --coverage",
    "build:cjs": "esbuild src/index.js --bundle --platform=node --format=cjs --minify --outfile=dist/cjs/index.cjs",
    "build:esm": "esbuild src/index.js --bundle --platform=node --format=esm --minify --outfile=dist/esm/index.js",
    "build": "npm run build:cjs && npm run build:esm",
    "prepublishOnly": "npm run build"
  },
  "keywords": [],
  "author": "Saboor Bhutta",
  "license": "ISC",
  "devDependencies": {
    "esbuild": "^0.25.3",
    "jest": "^29.7.0"
  }
}
